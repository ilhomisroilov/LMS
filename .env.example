# ──────────────── EduCore CRM + LMS — Environment (LOCAL) ────────────────
# Copy to .env and adjust before running.
# This setup runs entirely on your local machine (no containers).
# Requires locally installed PostgreSQL and (optionally) Redis.

# --- General ---
PROJECT_NAME=EduCore
ENVIRONMENT=development            # development | production
API_V1_PREFIX=/api/v1
DEFAULT_LANGUAGE=uz                # uz | en

# --- Postgres (local install, default localhost:5432) ---
POSTGRES_USER=educore
POSTGRES_PASSWORD=1
POSTGRES_DB=educore
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://educore:1@localhost:5432/educore

# --- Redis (optional; used for caching & rate limiting) ---
# If Redis is not running, the app still works — rate limiting just fails open.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# --- JWT / Security ---
SECRET_KEY=change-this-super-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
RATE_LIMIT_PER_MINUTE=120

# --- CORS (Vite dev server) ---
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- File storage (local for V1, S3/MinIO-ready for V2) ---
STORAGE_BACKEND=local              # local | s3
STORAGE_LOCAL_DIR=./storage/uploads

# --- Telegram Bot ---
TELEGRAM_BOT_TOKEN=put-your-bot-token-here
BOT_API_BASE_URL=http://localhost:8000/api/v1
BOT_DEFAULT_LANGUAGE=uz
BOT_API_TOKEN=bot-internal-secret-token

# --- Seed admin ---
FIRST_ADMIN_PHONE=+998901112233
FIRST_ADMIN_PASSWORD=Admin12345
